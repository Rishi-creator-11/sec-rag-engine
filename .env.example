# Copy to .env and fill in. Never commit the real file (.env is gitignored).

# Required for embeddings + generation.
OPENAI_API_KEY=

# Required for dense retrieval (Pinecone index: sec-rag-engine).
PINECONE_API_KEY=

# Required for reranking (Cohere rerank-v4.0-fast). Retrieval still works
# without it: a missing/failed/rate-limited call falls back to the hybrid
# top-5 and the response sets reranker_fallback=true.
COHERE_API_KEY=

# Comma-separated list of origins allowed to call this API (CORS). Defaults
# to "http://localhost:3000,https://secfrontend.vercel.app" if unset.
FRONTEND_ORIGINS=http://localhost:3000

# Required by the SEC EDGAR client -- SEC asks for a descriptive UA with a
# real contact so they can reach you if a script misbehaves.
SEC_USER_AGENT=your-project you@example.com

# Optional: enables logging every /ask call (question, scope, outcome,
# timings, cited sources -- never the evidence text) to Supabase for product
# analytics. No-op if either is unset. See api/ask_logging.py.
SUPABASE_URL=
SUPABASE_ANON_KEY=
