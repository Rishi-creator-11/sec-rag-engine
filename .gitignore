# Python
.venv/
__pycache__/
*.pyc

# Environment / secrets
.env
.env.*

# macOS
.DS_Store

# Local embedding dumps
data/embeddings/

# SEC EDGAR response cache (company_tickers.json etc.)
data/sec_cache/

# Local rollback snapshots (registry / ledger / Pinecone metadata before a
# controlled backfill). Kept on the operator's machine, not in git.
data/registry/backups/

# Persisted bm25s lexical index — TRACKED. The deployed runtime (Vercel) has a
# read-only filesystem and cannot rebuild it, so the prebuilt index is committed
# and bundled read-only into the function (vercel.json includeFiles). Rebuild
# with `python -m scripts.build_bm25s_index` after any ingestion/metadata change
# and commit the result. Only the transient tempfiles below are ignored.
data/bm25s_index/*.tmp
data/bm25s_index/.*.tmp*

# Ingestion rebuild artifacts (large, regenerable from SEC / from chunks).
# Kept OUT of git: raw HTML and cleaned text. Kept IN git: metadata.json
# (small record) and data/chunks/**/*.jsonl (the BM25 serving artifact).
data/raw/**/filing.html
data/raw/**/filing.txt
data/raw/**/*.tmp
data/**/.*.tmp*

# Large intermediate evaluation artifacts / caches
evaluation/results/benchmark_v2_pool.json
evaluation/results/benchmark_v3_pool.json
evaluation/results/cohere_reranker_cache.json
evaluation/results/reranker_cache.json
evaluation/results/benchmark_v2_auto_judgments.json
evaluation/results/benchmark_v2_judgments.json
evaluation/results/benchmark_v3_auto_judgments.json
evaluation/results/*_review.txt
evaluation/results/*.log
evaluation/results/retrieval_pool.json
evaluation/results/pool_judgments.json
evaluation/corpus_review.txt

# Local code review / inspection artifacts
codebase_status.txt
codebase_tree.txt
tracked_files.txt
git_history.txt
sec-rag-code-review.zip
