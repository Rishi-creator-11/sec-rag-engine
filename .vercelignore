# Keep the Vercel Python function bundle lean: ship only what the API needs at
# runtime — api/, ingestion/, retrieval/, and the tracked data under data/
# (data/bm25s_index/**, data/chunks/**, data/registry/*.json,
# data/raw/**/metadata.json).
#
# Gitignored paths (data/raw/**/filing.*, data/embeddings/, data/sec_cache/,
# data/registry/backups/, evaluation judge pools, *.log) are already absent from
# the Vercel git checkout; the rules below drop the remaining dev-only trees.

evaluation/
tests/
scripts/
notebooks/

.git/
.venv/
__pycache__/
*.pyc
.DS_Store
codebase_status.txt
codebase_tree.txt
tracked_files.txt
git_history.txt
sec-rag-code-review.zip
